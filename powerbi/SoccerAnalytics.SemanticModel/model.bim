{
  "name": "SoccerAnalytics",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "DimLeague",
        "description": "One row per league. Stable group means observed schedule structure reviewed, not proof of official completeness.",
        "columns": [
          {
            "name": "league_id",
            "dataType": "int64",
            "sourceColumn": "league_id",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "league",
            "dataType": "string",
            "sourceColumn": "league",
            "summarizeBy": "none"
          },
          {
            "name": "country",
            "dataType": "string",
            "sourceColumn": "country",
            "summarizeBy": "none"
          },
          {
            "name": "stable_comparison_sample",
            "dataType": "int64",
            "sourceColumn": "stable_comparison_sample",
            "summarizeBy": "none",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "sample_group",
            "dataType": "string",
            "sourceColumn": "sample_group",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimLeague",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"\"}, \"\"),",
                "    Source = Json.Document(Binary.FromText(Encoded, BinaryEncoding.Base64)),",
                "    Data = Table.FromRows(Source, {\"league_id\", \"league\", \"country\", \"stable_comparison_sample\", \"sample_group\"}),",
                "    Typed = Table.TransformColumnTypes(Data, {{\"league_id\", Int64.Type}, {\"league\", type text}, {\"country\", type text}, {\"stable_comparison_sample\", Int64.Type}, {\"sample_group\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
